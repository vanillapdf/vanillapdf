<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Target Name="CopyVanillaPDFNativeBinaries" AfterTargets="Build">
    <ItemGroup>
      <VanillaPdfNativeLibs Include="$(MSBuildThisFileDirectory)..\..\runtimes\@PLATFORM_IDENTIFIER@\native\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(VanillaPdfNativeLibs)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
