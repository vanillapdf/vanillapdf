%!PS-Adobe-3.0 Resource-CMap
%%DocumentNeededResources: ProcSet (CIDInit)
%%IncludeResource: ProcSet (CIDInit)
%%BeginResource: CMap (Test-CMap)
%%Title: (Test-CMap Adobe Identity 0)
%%Version: 1.000
%%EndComments

/CIDInit /ProcSet findresource begin

12 dict begin

begincmap

/CMapName /Test-CMap def
/CMapType 2 def

% Test case 1: PostScript-style dictionary
/CIDSystemInfo1 3 dict dup begin
/Registry (Adobe) def
/Ordering (Identity) def
/Supplement 0 def
end def

% Test case 2: PDF-style dictionary with def inside
/CIDSystemInfo2 <<
/Registry (Times-Roman+0) def
/Ordering (T1UV) def
/Supplement 0 def
>> def

1 begincodespacerange
<00> <FF>
endcodespacerange

endcmap
CMapName currentdict /CMap defineresource pop
end
end

%%EndResource
%%EOF