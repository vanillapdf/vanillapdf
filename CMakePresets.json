{
  "version": 8,

  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default Configuration",
      "description": "Use vcpkg toolchain and build into ./build",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/external/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CXX_STANDARD": "17",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF"
      }
    },
    {
      "name": "windows-x64-msvc",
      "inherits": "default",
      "description": "Windows build using Visual Studio",
      "displayName": "Windows x64 MSVC (Static CRT)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake"
      }
    },
    {
      "name": "linux-x64-gcc",
      "inherits": "default",
      "displayName": "Linux x64 GCC",
      "description": "Linux build with GCC and Ninja",
      "generator": "Ninja",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "macos-arm64",
      "inherits": "default",
      "displayName": "macOS ARM64 (Apple Silicon)",
      "description": "macOS ARM64 build with Ninja",
      "generator": "Ninja",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-x64",
      "inherits": "default",
      "displayName": "macOS Intel x64",
      "description": "macOS x64 build with Ninja",
      "generator": "Ninja",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-osx",
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    }
  ],

  "buildPresets": [
    { "name": "windows-x64-msvc", "configurePreset": "windows-x64-msvc" },
    { "name": "linux-x64-gcc", "configurePreset": "linux-x64-gcc" },
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "macos-x64", "configurePreset": "macos-x64" }
  ],

  "testPresets": [
    { "name": "windows-x64-msvc", "configurePreset": "windows-x64-msvc" },
    { "name": "linux-x64-gcc", "configurePreset": "linux-x64-gcc" },
    { "name": "macos-arm64", "configurePreset": "macos-arm64" },
    { "name": "macos-x64", "configurePreset": "macos-x64" }
  ]
}
