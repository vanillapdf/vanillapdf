{
    "name": "vanillapdf",
    "version": "2.1.0",
    "description": "PDF rendering engine using vcpkg-managed dependencies",
    "default-features": [
        "openssl",
        "libjpeg-turbo",
        "openjpeg",
        "zlib",
        "spdlog",
        "nlohmann-json"
    ],
    "features": {
        "openssl": {
            "dependencies": [ "openssl" ]
        },
        "libjpeg-turbo": {
            "dependencies": [ "libjpeg-turbo" ]
        },
        "openjpeg": {
            "dependencies": [ "openjpeg" ]
        },
        "zlib": {
            "dependencies": [ "zlib" ]
        },
        "spdlog": {
            "dependencies": [ "spdlog" ]
        },
        "nlohmann-json": {
            "dependencies": [ "nlohmann-json" ]
        },
        "tests": {
            "description": "Enable unit and integration tests",
            "dependencies": [
                "gtest"
            ]
        },
        "benchmarks": {
            "description": "Enable performance benchmarking tools",
            "dependencies": [
                "benchmark"
            ]
        }
    },
    "builtin-baseline": "ce613c41372b23b1f51333815feb3edd87ef8a8b"
}