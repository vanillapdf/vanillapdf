{
  "name": "vanillapdf",
  "version": "@VANILLAPDF_VERSION@",
  "description": "PDF rendering engine using vcpkg-managed dependencies",
  "features": {
    "encryption": {
      "description": "Enable encryption and decryption of secure PDF documents",
      "dependencies": [
        "openssl"
      ]
    },
    "jpeg": {
      "description": "Decode JPEG images into bitmaps",
      "dependencies": [
        "libjpeg-turbo"
      ]
    },
    "jpeg2000": {
      "description": "Support JPEG-2000 images through the OpenJPEG codec",
      "dependencies": [
        "openjpeg"
      ]
    },
    "zlib": {
      "description": "Decompress PDF objects compressed with zlib",
      "dependencies": [
        "zlib"
      ]
    },
    "spdlog": {
      "description": "High-performance logging for diagnostics and debugging",
      "dependencies": [
        "spdlog"
      ]
    },
    "fmt": {
      "description": "High-performance string formatting library",
      "dependencies": [
        "fmt"
      ]
    },
    "nlohmann-json": {
      "description": "Parse application configuration from JSON files",
      "dependencies": [
        "nlohmann-json"
      ]
    },
    "tests": {
      "description": "Enable unit and integration tests",
      "dependencies": [
        "gtest"
      ]
    },
    "benchmarks": {
      "description": "Enable performance benchmarking tools",
      "dependencies": [
        "benchmark"
      ]
    }
  },
  "builtin-baseline": "c3867e714dd3a51c272826eea77267876517ed99"
}
