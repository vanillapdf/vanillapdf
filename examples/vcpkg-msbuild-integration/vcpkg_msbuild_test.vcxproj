<?xml version="1.0" encoding="utf-8"?>
<!--
  Consumes vanillapdf through the vcpkg MSBuild integration, without CMake.

  This is what "vcpkg integrate install" does for every project of a user:
  vcpkg.props and vcpkg.targets add the include directory of the installed
  tree, link every library in its lib directory and copy the DLLs next to the
  executable. The project itself defines nothing, so the installed headers
  alone have to select __declspec(dllimport) for the shared library.

  The two files are imported from the vcpkg submodule of this repository
  rather than through "vcpkg integrate install", which would change the
  MSBuild setup of the whole user account. VcpkgRoot defaults to the vcpkg
  instance the files belong to, so the classic mode tree it consumes is
  external\vcpkg\installed.

  See README.md for how to install the port and build the project.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{6B3E1F0A-5C2D-4E8B-9A71-0D4F2C8E7B13}</ProjectGuid>
    <Keyword>Win32Proj</Keyword>
    <RootNamespace>VcpkgMsbuildTest</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <!-- The toolset of whichever Visual Studio builds the project -->
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <!-- Classic mode with the dynamic x64-windows triplet, the one where the linkage matters -->
  <PropertyGroup Label="Vcpkg">
    <VcpkgEnableManifest>false</VcpkgEnableManifest>
    <VcpkgUseStatic>false</VcpkgUseStatic>
  </PropertyGroup>
  <Import Project="..\..\external\vcpkg\scripts\buildsystems\msbuild\vcpkg.props" />

  <PropertyGroup>
    <OutDir>$(MSBuildProjectDirectory)\build\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildProjectDirectory)\build\obj\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <SDLCheck>true</SDLCheck>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="direct_link.c" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Import Project="..\..\external\vcpkg\scripts\buildsystems\msbuild\vcpkg.targets" />
</Project>
