{
    "version": 8,
    "configurePresets": [
        {
            "name": "android-arm64-release",
            "displayName": "Android arm64-v8a Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../../external/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
                "VCPKG_TARGET_TRIPLET": "arm64-android",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "21"
            }
        },
        {
            "name": "android-arm-release",
            "displayName": "Android armeabi-v7a Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../../external/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
                "VCPKG_TARGET_TRIPLET": "arm-neon-android",
                "ANDROID_ABI": "armeabi-v7a",
                "ANDROID_PLATFORM": "21"
            }
        },
        {
            "name": "android-x64-release",
            "displayName": "Android x86_64 Release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/../../external/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_ROOT}/build/cmake/android.toolchain.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-android",
                "ANDROID_ABI": "x86_64",
                "ANDROID_PLATFORM": "21"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "android-arm64-release",
            "configurePreset": "android-arm64-release"
        },
        {
            "name": "android-arm-release",
            "configurePreset": "android-arm-release"
        },
        {
            "name": "android-x64-release",
            "configurePreset": "android-x64-release"
        }
    ]
}
